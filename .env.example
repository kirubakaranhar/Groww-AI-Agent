# ==============================================================================
# GROWW AUTONOMOUS AI TRADING AGENT - CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROWW TRADING API CREDENTIALS
# ------------------------------------------------------------------------------
# Get your API key and secret from Groww Developer Console:
# https://groww.in/trade-api
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_ACCESS_TOKEN=
GROWW_ACCOUNT_ID=
GROWW_ENVIRONMENT=SANDBOX

# Set to true to use realistic mock market data feed when offline or testing without live API keys
USE_MOCK_FEED_IF_DISCONNECTED=true

# ------------------------------------------------------------------------------
# 2. CAPITAL & RISK LIMITS (CONFIGURABLE)
# ------------------------------------------------------------------------------
INITIAL_CAPITAL=5000.0
RISK_PER_TRADE=25.0
DAILY_MAX_LOSS=50.0
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=2
MAX_CAPITAL_ALLOCATION_PCT=0.90
MIN_RISK_REWARD_RATIO=1.5
TRAILING_STOP_LOSS_ENABLED=true
TRAILING_STOP_LOSS_ACTIVATION_R=1.0

# ------------------------------------------------------------------------------
# 3. STATUTORY & BROKERAGE ESTIMATION (INDIA NSE INTRADAY)
# ------------------------------------------------------------------------------
# Brokerage: ₹20 or 0.05% per executed order, whichever is lower
BROKERAGE_FLAT_INR=20.0
BROKERAGE_PCT=0.0005
# STT on sell side for equity intraday: 0.025%
STT_SELL_PCT=0.00025
# NSE Exchange Transaction Charge: 0.00297%
NSE_TXN_CHARGE_PCT=0.0000297
# SEBI Turnover Charge: ₹10 per crore (0.0001%)
SEBI_TURNOVER_PCT=0.000001
# Stamp Duty on buy side: 0.003%
STAMP_DUTY_BUY_PCT=0.00003
# GST: 18% on (Brokerage + Txn Charges + SEBI Charges)
GST_PCT=0.18
# Estimated slippage percentage (e.g. 0.05% for liquid stocks)
SLIPPAGE_PCT=0.0005

# ------------------------------------------------------------------------------
# 4. SAFETY & EXECUTION GATES
# ------------------------------------------------------------------------------
# PAPER TRADING IS THE ONLY SAFE DEFAULT EXECUTION MODE
PAPER_TRADING_ENABLED=true

# LIVE TRADING IS HARD-LOCKED BY DEFAULT.
# Setting this to true requires passing all SEBI/NSE compliance verifications,
# active verified Groww account, and confirmation token.
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PASSPHRASE=

# ------------------------------------------------------------------------------
# 5. MARKET TIMINGS (ASIA/KOLKATA IST)
# ------------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
PRE_MARKET_START=09:00
MARKET_OPEN_TIME=09:15
INTRADAY_SQUARE_OFF_TIME=15:15
MARKET_CLOSE_TIME=15:30

# When true, allows running market simulation / paper trading even outside 9:15 - 15:30 IST
SIMULATE_MARKET_HOURS=false

# ------------------------------------------------------------------------------
# 6. SCANNER & AGENT SETTINGS
# ------------------------------------------------------------------------------
SCANNER_BATCH_SIZE=25
SCAN_INTERVAL_SECONDS=15
DECISION_MIN_SCORE_THRESHOLD=70.0
UNUSUAL_VOLUME_MULTIPLIER=1.5

# ------------------------------------------------------------------------------
# 7. SERVER & SYSTEM SETTINGS
# ------------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=backend/database/trading_system.db
